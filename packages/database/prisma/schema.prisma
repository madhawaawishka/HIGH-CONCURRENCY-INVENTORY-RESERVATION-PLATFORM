// PostgreSQL is the source of truth for inventory and all transactional state (ADR-0002).
//
// Tables are added in the week their code first needs them; each change is a new migration.
// Invariants Prisma cannot express (CHECK constraints, partial indexes) live in hand-written SQL
// inside the migration files: see prisma/migrations/*/migration.sql.

generator client {
  provider             = "prisma-client"
  output               = "../src/generated/prisma"
  moduleFormat         = "esm"
  importFileExtension  = "js"
}

datasource db {
  provider = "postgresql"
}

enum ProductStatus {
  ACTIVE
  INACTIVE

  @@map("product_status")
}

/// Catalog module. Ids are UUIDv7 generated by the application, so they sort by creation time
/// and support keyset pagination on the primary key alone.
model Product {
  id         String        @id @db.Uuid
  sku        String        @unique @db.VarChar(64)
  name       String        @db.VarChar(200)
  /// Unit price in minor units (cents). Never a float.
  priceCents Int           @map("price_cents")
  currency   String        @db.Char(3)
  status     ProductStatus @default(ACTIVE)
  createdAt  DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  inventory Inventory?

  @@map("products")
}

/// Inventory module. Every unit is in exactly one bucket:
/// total_quantity = available_quantity + reserved_quantity + sold_quantity (CHECK constraint).
model Inventory {
  productId         String   @id @map("product_id") @db.Uuid
  totalQuantity     Int      @default(0) @map("total_quantity")
  availableQuantity Int      @default(0) @map("available_quantity")
  reservedQuantity  Int      @default(0) @map("reserved_quantity")
  soldQuantity      Int      @default(0) @map("sold_quantity")
  /// Optimistic-concurrency version, incremented on every change.
  version           Int      @default(0)
  updatedAt         DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@map("inventory")
}

/// Append-only record of security-relevant and administrative actions.
model AuditLog {
  id            String   @id @db.Uuid
  actorId       String   @map("actor_id") @db.VarChar(100)
  action        String   @db.VarChar(100)
  aggregateType String   @map("aggregate_type") @db.VarChar(50)
  aggregateId   String   @map("aggregate_id") @db.VarChar(100)
  metadata      Json     @default("{}")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([aggregateType, aggregateId, createdAt])
  @@map("audit_logs")
}
