{
  "name": "stockforge",
  "version": "0.1.0",
  "private": true,
  "description": "High-concurrency inventory and reservation platform (portfolio engineering project).",
  "type": "module",
  "packageManager": "pnpm@11.1.2",
  "engines": {
    "node": ">=24.15.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "prepare": "husky",
    "build": "pnpm db:generate && tsc -b",
    "clean": "tsc -b --clean",
    "dev": "pnpm --filter @stockforge/api run dev",
    "typecheck": "pnpm -r run typecheck",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "arch:check": "depcruise apps packages --config .dependency-cruiser.cjs",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:cov": "vitest run --project unit --coverage",
    "test:int": "vitest run --project integration",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm arch:check && pnpm test",
    "db:up": "docker compose up -d --wait postgres",
    "db:down": "docker compose down",
    "db:generate": "pnpm --filter @stockforge/database run generate",
    "db:migrate": "pnpm --filter @stockforge/database run migrate:deploy",
    "db:migrate:create": "pnpm --filter @stockforge/database run migrate:create",
    "db:seed": "pnpm --filter @stockforge/database run seed",
    "bootstrap": "pnpm db:up && pnpm db:generate && pnpm db:migrate && pnpm db:seed"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/js": "^10.0.1",
    "@swc/core": "^1.16.13",
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "^5.0.3",
    "@vitest/eslint-plugin": "^1.6.27",
    "dependency-cruiser": "^18.5.0",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "unplugin-swc": "^2.0.0",
    "vitest": "^5.0.3"
  }
}
