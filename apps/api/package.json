{
  "name": "@stockforge/api",
  "version": "0.1.0",
  "private": true,
  "description": "NestJS modular monolith: catalog, inventory and orders HTTP API.",
  "type": "module",
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "dev": "tsc -b tsconfig.build.json && pnpm run --parallel \"/^dev:/\"",
    "dev:compile": "tsc -b tsconfig.build.json --watch --preserveWatchOutput",
    "dev:serve": "node --watch --enable-source-maps --env-file-if-exists=../../.env dist/main.js",
    "start": "node --enable-source-maps dist/main.js"
  },
  "dependencies": {
    "@nestjs/common": "^12.1.2",
    "@nestjs/core": "^12.1.2",
    "@nestjs/platform-express": "^12.1.2",
    "@nestjs/swagger": "^12.0.2",
    "@stockforge/contracts": "workspace:*",
    "@stockforge/database": "workspace:*",
    "@stockforge/shared-kernel": "workspace:*",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@nestjs/testing": "^12.1.2",
    "@testcontainers/postgresql": "^12.2.0",
    "@types/express": "^5.0.6",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.3.1"
  }
}
