# Copy to .env for local development. Never commit .env.
# Every variable is validated at startup; the process refuses to start on invalid values.

NODE_ENV=development
PORT=3000

# Matches the PostgreSQL service in docker-compose.yml. 127.0.0.1 (not "localhost") makes sure
# the connection reaches the container even if another PostgreSQL (e.g. inside WSL) is bound to ::1.
DATABASE_URL=postgresql://stockforge:stockforge@127.0.0.1:5432/stockforge
# Maximum connections per process (see the connection budget in spec Section 25).
DATABASE_POOL_MAX=10

# Interim admin credential until JWT authentication lands in Week 2.
# Use a long random value, e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"`.
ADMIN_API_KEY=replace-with-a-long-random-value-of-at-least-32-characters
